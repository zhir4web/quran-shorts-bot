{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/overview",
      "destination": "/api?route=overview"
    },
    {
      "source": "/api/config",
      "destination": "/api?route=config"
    },
    {
      "source": "/api/workflow",
      "destination": "/api?route=workflow"
    },
    {
      "source": "/api/submit-clip",
      "destination": "/api?route=submit-clip"
    },
    {
      "source": "/api/schedule-trigger",
      "destination": "/api?route=schedule-trigger"
    },
    {
      "source": "/",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/dashboard/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,work/**,state/**,.bot-state/**,assets/**,diagnostics/**,legacy/**,outputs/**,.github/**,**/*.mp4,**/*.mov,**/*.webm,**/*.mp3,**/*.wav,**/*.png,**/*.jpg,**/*.zip,**/*.ttf}"
    }
  }
}
